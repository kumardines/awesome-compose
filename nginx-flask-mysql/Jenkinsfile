pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        COMPOSE_PROJECT_NAME = 'assessment'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Reports') {
            steps {
                dir('nginx-flask-mysql/reports') {
                    deleteDir()
                }
                dir('nginx-flask-mysql') {
                    sh 'mkdir -p reports'
                }
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -eu
                    docker info > /dev/null
                    docker compose version
                    trivy --version
                    curl --version
                    bash --version
                '''
            }
        }

        stage('Validate Configuration') {
            steps {
                dir('nginx-flask-mysql') {
                    sh '''
                        set -eu
                        docker compose config --quiet
                        test -f deploy.sh
                        bash -n deploy.sh
                    '''
                }
            }
        }

        stage('Build Images') {
            steps {
                dir('nginx-flask-mysql') {
                    sh '''
                        set -eu
                        docker compose build --pull db backend proxy
                    '''
                }
            }
        }

        stage('Python Syntax Check') {
            steps {
                dir('nginx-flask-mysql') {
                    sh '''
                        set -eu
                        docker compose run --rm --no-deps backend python -m py_compile hello.py
                    '''
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                dir('nginx-flask-mysql') {
                    sh '''
                        set -eu

                        docker compose config --images > reports/images-unsorted.txt
                        sort -u reports/images-unsorted.txt > reports/images.txt
                        test -s reports/images.txt

                        scan_failed=0
                        index=0

                        while IFS= read -r image; do
                            index=$((index + 1))
                            echo "Scanning image: $image"

                            if trivy image --scanners vuln --severity HIGH,CRITICAL --exit-code 1 --format table --output "reports/trivy-${index}.txt" "$image"; then
                                echo "Scan passed: $image"
                            else
                                echo "Scan failed: $image"
                                scan_failed=1
                            fi
                        done < reports/images.txt

                        exit "$scan_failed"
                    '''
                }
            }
        }

        stage('Deploy and Verify with Rollback') {
            steps {
                dir('nginx-flask-mysql') {
                    sh 'bash deploy.sh'
                }
            }
        }
    }
            stage('Image Cleanup') {
            steps {
                dir('nginx-flask-mysql') {
                    sh 'bash cleanup.sh'
                }
            }
        }

    post {
        always {
            dir('nginx-flask-mysql') {
                sh '''
                    mkdir -p reports

                    docker compose ps -a > reports/container-status.txt 2>&1 || true
                    docker compose logs --no-color --tail=100 > reports/container-logs.txt 2>&1 || true
                '''
            }

            archiveArtifacts(
                artifacts: 'nginx-flask-mysql/reports/**',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Build, scan, deployment, and HTTP verification passed.'
        }

        failure {
            echo 'Build failed. Check Console Output for the failed stage and any rollback result.'
        }
    }
}
